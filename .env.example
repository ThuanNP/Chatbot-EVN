# Khoá API của Google Gemini
GOOGLE_API_KEY=dan-khoa-that-vao-day

# Khoá API của OpenRouter
OPENROUTER_API_KEY=dan-khoa-that-vao-day

# Khoá API của Anthropic (Claude)
ANTHROPIC_API_KEY=dan-khoa-that-vao-day

# Khoá API của OpenAI
OPENAI_API_KEY=dan-khoa-that-vao-day

# Chuỗi kết nối cơ sở dữ liệu PostgreSQL
DATABASE_URL=postgresql+psycopg://dan-khoa-that-vao-day:dan-khoa-that-vao-day@localhost:5432/dan-khoa-that-vao-day

# Khoá bí mật dùng cho ứng dụng
APP_SECRET=dan-khoa-that-vao-day

# Ngân sách giới hạn tối đa mỗi ngày (USD)
NGAN_SACH_NGAY_USD=10.0

# Hạn mức số lượt yêu cầu tối đa mỗi người dùng trong một giờ
HAN_MUC_MOI_NGUOI_GIO=60

# Hạn mức số lượt yêu cầu dồn dập tối đa theo địa chỉ IP trong 1 phút
HAN_MUC_IP_PHUT=20

# Hệ số nhân hạn mức mỗi giờ dành cho người dùng bậc pro
HE_SO_BAC_PRO=5

# Hạn mức chi phí tối đa trong ngày cho người dùng bậc free (USD)
HAN_MUC_CHI_PHI_NGAY_FREE_USD=1.0

# Hạn mức chi phí tối đa trong ngày cho người dùng bậc pro (USD)
HAN_MUC_CHI_PHI_NGAY_PRO_USD=5.0

# Môi trường thực thi của ứng dụng (development, staging, production)
MOI_TRUONG=development

# Danh sách các miền được phép truy cập CORS (phân tách bởi dấu phẩy, cấm dùng * trong production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Cờ cho phép ghi nội dung tin nhắn vào nhật ký (CHỈ BẬT TRONG MÔI TRƯỜNG PHÁT TRIỂN / DEV, MẶC ĐỊNH TẮT ĐỂ BẢO VỆ DỮ LIỆU)
GHI_NOI_DUNG=false
