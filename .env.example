# Khoá API của Google Gemini
GOOGLE_API_KEY=dan-khoa-that-vao-day

# Khoá API của OpenRouter
OPENROUTER_API_KEY=dan-khoa-that-vao-day

# Khoá API của Anthropic (Claude)
ANTHROPIC_API_KEY=dan-khoa-that-vao-day

# Khoá API của OpenAI
OPENAI_API_KEY=dan-khoa-that-vao-day

# Chuỗi kết nối cơ sở dữ liệu PostgreSQL
DATABASE_URL=postgresql+psycopg://dan-khoa-that-vao-day:dan-khoa-that-vao-day@localhost:5432/dan-khoa-that-vao-day

# Khoá bí mật dùng cho ứng dụng
APP_SECRET=dan-khoa-that-vao-day

# Ngân sách giới hạn tối đa mỗi ngày (USD)
NGAN_SACH_NGAY_USD=10.0

# Hạn mức số lượt yêu cầu tối đa mỗi người dùng trong một giờ
HAN_MUC_MOI_NGUOI_GIO=60

# Môi trường thực thi của ứng dụng (development, staging, production)
MOI_TRUONG=development
