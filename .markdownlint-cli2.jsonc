{
  // Tuỳ chọn riêng của markdownlint-cli2.
  // Các rule định dạng nằm ở .markdownlint.json — cli2 đọc và gộp cả hai tệp.
  // Nhờ khai báo globs ở đây, chỉ cần chạy `npx markdownlint-cli2` không tham số.

  "globs": ["**/*.md"],

  "ignores": [
    ".venv/**",
    "node_modules/**",
    ".pytest_cache/**",

    // Bộ đệm phiên do plugin sinh tự động, không phải tài liệu của dự án
    ".remember/**",

    // Skill pack vendor, giữ nguyên định dạng gốc của nhà cung cấp
    ".agents/skills/**"
  ],

  "outputFormatters": [["markdownlint-cli2-formatter-default"]]
}
